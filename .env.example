# ─── Required ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:devpassword@localhost:5434/drapi
REDIS_URL=redis://:devredispass@localhost:6379/0
SECRET_KEY=change-me-to-a-random-32-char-string-minimum

# ─── Environment ───────────────────────────────────────────────────────────────
ENVIRONMENT=development

# ─── LLM Provider (set at least one) ──────────────────────────────────────────
# OpenAI / OpenAI-compatible
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-haiku-20240307

# Local / Ollama (OpenAI-compatible endpoint)
# LOCAL_LLM_URL=http://localhost:11434/v1
# LOCAL_LLM_MODEL=llama3.2

# ─── Search ────────────────────────────────────────────────────────────────────
SEARXNG_URL=http://localhost:8085

# ─── Tuning ────────────────────────────────────────────────────────────────────
MAX_RESEARCH_ROUNDS=3
EXTRACTION_CONCURRENCY=3

# ─── Docker Compose overrides ─────────────────────────────────────────────────
PG_PASSWORD=devpassword
PG_PORT=5434
REDIS_PASSWORD=devredispass
REDIS_PORT=6379
SEARXNG_PORT=8085
API_PORT=8000

# ─── Caddy (production only) ───────────────────────────────────────────────────
# DOMAIN=research.yourdomain.com
# ACME_EMAIL=you@yourdomain.com
