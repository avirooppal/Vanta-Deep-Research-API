# ==============================================================================
# Vanta Deep Research — Cloud Deployment Environment Variables (.env.cloud)
# ==============================================================================

# ── 1. General & Security ─────────────────────────────────────────────────────
ENVIRONMENT=production
# Generate a strong 32+ character key: openssl rand -hex 32
SECRET_KEY=replace-with-a-random-secure-32-char-string-for-production!

# ── 2. Database (PostgreSQL with pgvector) ────────────────────────────────────
# For Cloud Services (Supabase, Neon, Railway Postgres, Render Postgres, AWS RDS):
# Standard format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://postgres:YourSecurePassword@db-host.internal:5432/drapi
PG_PASSWORD=YourSecurePostgresPasswordHere

# ── 3. Queue & Cache (Redis) ──────────────────────────────────────────────────
# For Cloud Services (Upstash Redis, Railway Redis, Render Redis, Redis Cloud):
# Standard format: redis://:password@redis-host:6379/0 or rediss:// for TLS
REDIS_URL=redis://:YourSecureRedisPassword@redis-host.internal:6379/0
REDIS_PASSWORD=YourSecureRedisPasswordHere

# ── 4. Web Search Engine ──────────────────────────────────────────────────────
# Internal Docker SearXNG on VPS or public/managed SearXNG instance
SEARXNG_URL=http://searxng:8080

# ── 5. Cloud Container Options ────────────────────────────────────────────────
# Set to 'true' if running both API and ARQ Worker in a single container (e.g. Render / Railway single dyno)
SINGLE_CONTAINER_MODE=true
# Set to the port assigned by cloud host (Render, Railway, Cloud Run auto-populate $PORT)
PORT=8000
WEB_CONCURRENCY=2

# ── 6. Domain & SSL (Only if using deploy/docker-compose.cloud.yml with Caddy) ──
DOMAIN=api.vanta.yourdomain.com
ACME_EMAIL=your-email@example.com

# ── 7. Research Engine Concurrency ───────────────────────────────────────────
MAX_RESEARCH_ROUNDS=3
EXTRACTION_CONCURRENCY=3
